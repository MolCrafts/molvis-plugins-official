{
  "name": "@molcrafts/molvis-plugin-pyodide-molpy",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "MolVis plugin: JupyterLite pyodide-kernel + molpy notebook",
  "license": "BSD-3-Clause",
  "scripts": {
    "prebuild": "node scripts/pack-local-py.mjs",
    "pretypecheck": "node scripts/pack-local-py.mjs",
    "pretest": "node scripts/pack-local-py.mjs",
    "pack:local-py": "node scripts/pack-local-py.mjs",
    "copy:workers": "node scripts/copy-kernel-workers.mjs",
    "build": "rsbuild build && npm run copy:workers",
    "typecheck": "tsc --noEmit",
    "test": "rstest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "check:contract": "node scripts/check-vendored-contract.mjs"
  },
  "peerDependencies": {
    "@molcrafts/molvis-core": ">=0.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "@jupyterlab/services": "^7.6.0",
    "@jupyterlite/pyodide-kernel": "^0.8.2",
    "@jupyterlite/services": "^0.8.1",
    "@lumino/coreutils": "^2.2.3",
    "@lumino/signaling": "^2.1.6"
  },
  "devDependencies": {
    "@molcrafts/molvis-core": "^0.1.1",
    "@rsbuild/core": "^2.1.9",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rstest/core": "^0.11.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  }
}
