{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "rsbuild.config.ts",
    "rslib.config.ts",
    "rspack.shared.ts",
    "rstest.config.ts",
    "rstest.e2e.config.ts"
  ]
}
