{
  "name": "@molcrafts/molvis-plugin-alchemist",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "description": "Alchemist \u2014 a canvas chemistry merge game: MolVis page plugin with static-site deployment",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/MolCrafts/molvis-plugins-official.git"
  },
  "homepage": "https://github.com/MolCrafts/molvis-plugins-official",
  "bugs": {
    "url": "https://github.com/MolCrafts/molvis-plugins-official/issues"
  },
  "keywords": [
    "alchemist",
    "game",
    "canvas",
    "molvis",
    "molcrafts",
    "plugin"
  ],
  "scripts": {
    "dev": "rsbuild dev",
    "build:site": "rsbuild build",
    "build:plugin": "rslib build",
    "build": "tsc --noEmit && npm run build:site && npm run build:plugin",
    "test": "rstest run --config rstest.config.ts",
    "test:watch": "rstest watch --config rstest.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.9",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rslib/core": "*",
    "@rspack/core": "*",
    "@rstest/core": "^0.11.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@molcrafts/molvis-plugin": ">=0.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
