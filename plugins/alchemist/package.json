{
  "name": "@molcrafts/molvis-plugin-alchemist",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Alchemist \u2014 a canvas chemistry merge game: MolVis page plugin with static-site deployment",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/MolCrafts/molvis-plugin-template.git"
  },
  "homepage": "https://github.com/MolCrafts/molvis-plugin-template",
  "bugs": {
    "url": "https://github.com/MolCrafts/molvis-plugin-template/issues"
  },
  "keywords": [
    "alchemist",
    "game",
    "canvas",
    "molvis",
    "molcrafts",
    "plugin"
  ],
  "scripts": {
    "dev": "rsbuild dev",
    "build:site": "rsbuild build",
    "build:plugin": "rslib build",
    "build": "npm run build:site && npm run build:plugin",
    "test": "rstest run --config rstest.config.ts",
    "test:watch": "rstest watch --config rstest.config.ts",
    "test:e2e": "rstest run --config rstest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.9",
    "@rslib/core": "*",
    "@rspack/core": "*",
    "@rstest/core": "^0.11.5",
    "@rstest/playwright": "*",
    "playwright": "*",
    "typescript": "^7.0.2",
    "@rsbuild/plugin-react": "^2.1.0"
  }
}
