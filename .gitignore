# Dependencies
node_modules/
package-lock.json
npm-shrinkwrap.json
yarn.lock
pnpm-lock.yaml

# TypeScript / bundler cache
*.tsbuildinfo
.turbo/
.cache/
.rspack-cache/

# Local / secrets
.DS_Store
.env
.env.*
!.env.example
*.local
.claude/settings.local.json

# Logs & diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Build analysis reports (RSDOCTOR=true)
.rsdoctor/
**/.rsdoctor/

# Test / coverage artifacts
coverage/
*.lcov
.nyc_output/
rstest-report/
.pytest_cache/
__pycache__/

# Built artifacts — never commit. CI builds; GitHub Releases host packages.
dist/
plugins/*/dist/
release-assets/
plugins/pyodide-molpy/runtime-wheels/
molvis-src-manifest.json
# Optional local symlink → ../molvis/python/src/molvis
molvis-src

# Generated from src/py/*.py by scripts/pack-py.mjs. The .py sources are
# in-repo, so there is nothing for CI to miss and nothing to hand-sync.
plugins/pyodide-molpy/src/kernel/generated_py.ts
plugins/pyodide-molpy/src/notebooks/generated.ts
